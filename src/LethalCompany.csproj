<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GameName>LethalCompany</GameName>
    <TargetFramework>netstandard2.1</TargetFramework>

    <!-- The ONE place the mod version lives. Everything else (BepInPlugin, AssemblyVersion, logs, the
         version the Crowd Control app asks for, /ccversion, ccver files, thunderstore/manifest.json)
         is generated from it at build time. -->
    <Version>1.2.2</Version>

    <RootNamespace>CrowdControl</RootNamespace>
    <!-- Kept as "CrowdControl" (rather than CrowdControl.$(GameName)) so the new build drops in over the
         file existing installs already have in BepInEx\plugins. -->
    <AssemblyName>CrowdControl</AssemblyName>
    <Product>Crowd Control for Lethal Company</Product>

    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <!-- Compile against the game build players actually have. A stale version here compiles fine and then
         throws MissingMethodException in the game (this is how v81 broke 1.1.17/1.1.18). -->
    <PackageReference Include="LethalCompany.GameLibs.Steam" Version="81.0.5-ngd.0" />
    <PackageReference Include="NotAtomicBomb.TerminalApi" Version="1.5.4" />
    <!-- The game ships Newtonsoft.Json 13.0.x in its Managed folder, so the package is compile-only here.
         13.0.3 is the floor the GameLibs package requires and what the mod has always built against; don't
         move past 13.0.x - newer packages add overloads that compile fine and then throw MissingMethodException
         in the game. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConnectorLib.JSON\ConnectorLib.JSON.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="bin\**;obj\**" />
  </ItemGroup>

  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <!-- The example turns overflow checking on. The game logic here predates it and was written (and tested
         for years) without it, where a float-to-int cast that overflows wraps instead of throwing, so it
         stays off rather than turning silent wraps into exceptions in old effect code. -->
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <Company>Warp World, Inc.</Company>
    <Copyright>© 2025 Warp World, Inc.</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <!-- BepInPlugin needs a compile-time constant, so emit one (and the assembly version) from $(Version). -->
  <Target Name="GenerateModVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <ModVersionFile>$(IntermediateOutputPath)ModVersion.g.cs</ModVersionFile>
    </PropertyGroup>
    <ItemGroup>
      <ModVersionLine Include="[assembly: System.Reflection.AssemblyVersion(&quot;$(Version)&quot;)]" />
      <ModVersionLine Include="[assembly: System.Reflection.AssemblyFileVersion(&quot;$(Version)&quot;)]" />
      <ModVersionLine Include="[assembly: System.Reflection.AssemblyInformationalVersion(&quot;$(Version)&quot;)]" />
      <ModVersionLine Include="internal static class ModVersion { public const string Value = &quot;$(Version)&quot;%3B }" />
    </ItemGroup>
    <WriteLinesToFile File="$(ModVersionFile)" Lines="@(ModVersionLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(ModVersionFile)" />
      <FileWrites Include="$(ModVersionFile)" />
    </ItemGroup>
  </Target>

  <!-- WriteLinesToFile always appends a newline; ccver and the manifest are written byte-exact. -->
  <UsingTask TaskName="WriteExactText" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Path ParameterType="System.String" Required="true" />
      <Text ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (!System.IO.File.Exists(Path) || System.IO.File.ReadAllText(Path) != Text) System.IO.File.WriteAllText(Path, Text);
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Release builds stage the plugin (and ConnectorLib.JSON, which it now needs) into mod/ and thunderstore/,
       and stamp the version there. -->
  <Target Name="StageRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <RepoRoot>$(MSBuildProjectDirectory)/..</RepoRoot>
      <ManifestPath>$(RepoRoot)/thunderstore/manifest.json</ManifestPath>
      <ManifestText>$([System.IO.File]::ReadAllText($(ManifestPath)))</ManifestText>
      <ManifestText>$([System.Text.RegularExpressions.Regex]::Replace($(ManifestText), '"version_number":\s*"[^"]*"', '"version_number": "$(Version)"'))</ManifestText>
    </PropertyGroup>
    <ItemGroup>
      <StageDir Include="$(RepoRoot)/mod/BepInEx/plugins;$(RepoRoot)/thunderstore/BepInEx/plugins" />
      <StageFile Include="$(TargetPath);$(TargetDir)ConnectorLib.JSON.dll" />
      <CcverFile Include="$(RepoRoot)/mod/ccver;$(RepoRoot)/mod/BepInEx/plugins/ccver;$(RepoRoot)/thunderstore/ccver;$(RepoRoot)/thunderstore/BepInEx/plugins/ccver" />
    </ItemGroup>
    <Copy SourceFiles="@(StageFile)" DestinationFolder="%(StageDir.Identity)" />
    <WriteExactText Path="%(CcverFile.Identity)" Text="$(Version)" />
    <WriteExactText Path="$(ManifestPath)" Text="$(ManifestText)" />
  </Target>
</Project>
